{
  "name": "whos-hues",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:package": "npm run build && electron-packager . \"Whos-Hues\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(node_modules|src|server|release|\\.git|public|tsconfig\\.json|vite\\.config\\.ts|package-lock\\.json)\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "socket.io": "^4.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^1.17.12",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.whoshues.app",
    "productName": "Who's Hues",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  }
}
